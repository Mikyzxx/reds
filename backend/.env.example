# Copia este archivo a backend/.env y ajusta los valores.

# ── Base de datos ────────────────────────────────────────────────
DB_ENGINE=mysql            # mysql | postgres
DB_HOST=127.0.0.1
DB_PORT=3306               # 5432 para postgres
DB_USER=admin
DB_PASSWORD=
DB_NAME=appdb
# DATABASE_URL=            # URL completa (Railway/Render); si existe, manda

# ── Auth ─────────────────────────────────────────────────────────
SECRET_KEY=nexa-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── GitHub (IDE) ─────────────────────────────────────────────────
# OAuth App con callback http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000

# ── Almacenamiento de archivos (avatares + adjuntos del chat) ────
# local (default): en disco, backend/uploads/ — para desarrollo.
# s3: bucket privado de AWS S3 o compatible (R2, MinIO). El backend sirve
#     los archivos con redirects a URLs presignadas; el bucket NO debe ser
#     público. Necesario en deploys con disco efímero (Railway/Render).
STORAGE_BACKEND=local      # local | s3
# S3_BUCKET=nexa-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=         # solo para R2/MinIO; vacío = AWS
# S3_PRESIGN_EXPIRES=3600  # segundos de validez de las URLs presignadas
